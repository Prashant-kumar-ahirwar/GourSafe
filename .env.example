# ============================================================
# GourSafe — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in real values. Never commit the
# actual `.env` file — only this example file belongs in git.
#
# NOTE: nothing in app.py reads a .env file automatically yet (no
# python-dotenv is installed) — these are documented here as the
# variables Render/your host should have set, and as placeholders for
# the Supabase migration you're doing yourself.

# ── Current app (already in use — see README.md) ──────────────
SECRET_KEY=
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=

# ── Supabase (not wired up yet — for your own migration) ───────
# Project URL and keys, from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, if you replace SQLite with
# Supabase's Postgres database directly (Project Settings -> Database)
DATABASE_URL=
